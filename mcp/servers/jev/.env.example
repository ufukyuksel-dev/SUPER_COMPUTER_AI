# Jev MCP — secrets live OUTSIDE the repository:
#   $JEV_ENV_FILE, default ~/.config/super-computer-ai/credentials/jev/.env (0600). Loaded only if the file exists;
#   values already exported in the environment take precedence.

# TypeSafe System One key (required for Jev's element choice).
TYPESAFE_API_KEY=

# Token of the Playwright MCP Chrome extension (only for --backend extension).
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Optional
# ANTHROPIC_API_KEY=  # secret; only for the v4 engine with JEV_HELPER=api
# JEV_STATE_DIR=      # browser profiles and logs; default ~/.local/state/super-computer-ai/jev (0700)
# JEV_ENGINE=v3       # v3 (default) or v4
# JEV_HELPER=api      # v4 helper provider: api (default, needs ANTHROPIC_API_KEY) or cli (`claude -p`)
# JEV_HELPER_MODEL=   # v4 helper model; default in src/jev/v4/helper.py
# JEV_PROGRESS=       # path of a JSONL file that receives one line per v4 decision/action (live progress)

# Set in the MCP client / launcher environment, not in this file:
# JEV_ENV_FILE=       # this file's location; default ~/.config/super-computer-ai/credentials/jev/.env
