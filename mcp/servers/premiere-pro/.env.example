# Adobe Premiere Pro MCP — configuration (no secrets). Copy values into the MCP client entry or
# ~/.config/super-computer-ai/credentials/premiere-pro/.env (0600) once the Phase-2 launcher is in place.

# Bridge directory shared with the CEP panel "Temp Directory". Default: ~/.premiere-mcp-bridge/bridge
PREMIERE_TEMP_DIR=

# 1 = advertise every tool in tools/list (for hosts with deferred tool schemas); default: small always-on set
PREMIERE_MCP_TOOLSET=

# Telemetry and npm update check are OFF by default in this fork; set to 1 only to opt in.
PREMIERE_MCP_TELEMETRY=0
PREMIERE_MCP_UPDATE_CHECK=0

# Optional
# DO_NOT_TRACK=1                    # standard opt-out; disables telemetry regardless of the setting above
# PREMIERE_MCP_TELEMETRY_DEBUG=1    # report failed telemetry sends on stderr (only when telemetry is on)
# PREMIERE_MCP_TELEMETRY_URL=       # override the telemetry ingest URL (only when telemetry is on)
