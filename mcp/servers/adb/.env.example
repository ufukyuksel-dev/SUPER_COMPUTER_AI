# adb MCP — needs NO secrets. All variables are optional; export them in the MCP client's server entry.

# Screenshots, videos, UI dumps, pulled files, host transfers and logs.
# Absolute path or ~/...; default ~/.local/state/super-computer-ai/adb, made 0700. Never inside a project checkout.
# ADB_MCP_STATE_DIR=

# Host directory that push_file may read from (default: $ADB_MCP_STATE_DIR/transfers).
# ADB_MCP_TRANSFERS_DIR=
