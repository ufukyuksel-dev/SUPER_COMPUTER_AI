# Google Ads MCP — one set per instance (e.g. production and test). No secret VALUES belong here or in the repo.

# Instance config (JSON, see config.example.json). Required; the server refuses to start without it.
# Keep it outside the repository, e.g. ~/.config/super-computer-ai/credentials/google-ads/<instance>/config.json
GOOGLE_ADS_CONFIG=

# Directory with developer-token.txt and service-account.json (0700 dir, 0600 files). Required.
GOOGLE_ADS_CREDENTIAL_DIR=

# Optional: audit log location (default: audit.jsonl next to GOOGLE_ADS_CONFIG).
GOOGLE_ADS_AUDIT_PATH=

# Deprecated aliases still accepted (warning on stderr): WORDFALL_ADS_CONFIG, WORDFALL_ADS_CREDENTIAL_DIR
